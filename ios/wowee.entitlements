<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Signed in only with -DWOWEE_IOS_INCREASED_MEMORY_LIMIT=ON.

  Raises the memory ceiling iOS terminates the app at, which a streaming
  world client runs close to on a 6 GB phone. The capability has to be in the
  provisioning profile too, and a free account's profile does not carry it:
  signing with this file there fails, which is why it is not the default.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
</dict>
</plist>
